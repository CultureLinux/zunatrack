{% extends 'base.html.twig' %}
{% block title %}Calendrier · ZunaTrack{% endblock %}
{% block body %}<section class="calendar" aria-labelledby="calendar-title"><header class="calendar-header"><div><p class="eyebrow">À venir · votre bibliothèque</p><h1 id="calendar-title">Calendrier des sorties</h1><p class="lede">Les prochains épisodes que vous n’avez pas encore vus.</p></div><a class="button calendar-export" href="{{ path('app_calendar_ical') }}"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 17v3h14v-3"/></svg>Exporter iCalendar</a></header>{% if episodes %}<div class="calendar-list">{% for item in episodes %}{% set airing = item.episode.airedAt ?? item.episode.airDate %}{% set days = date('today').diff(airing).days %}<article class="calendar-card"><a class="calendar-card__countdown" href="{{ path('app_series_show', {id:item.series.id, saison:item.season.number}) }}#episode-{{ item.episode.id }}" aria-label="Voir {{ item.episode.title }}"><strong>{{ days == 0 ? 'Aujourd’hui' : days == 1 ? 'Demain' : 'Dans ' ~ days ~ ' jours' }}</strong><small>avant diffusion</small></a><time class="calendar-card__date" datetime="{{ airing|date('c') }}"><strong>{{ airing|date('d') }}</strong><span>{{ airing|date('M')|upper }}</span><small>{% if item.episode.airedAt %}{{ item.episode.airedAt|date('H:i', 'Europe/Paris') }}{% else %}Toute la journée{% endif %}</small></time><a class="calendar-card__cover" href="{{ path('app_series_show', {id:item.series.id, saison:item.season.number}) }}#episode-{{ item.episode.id }}" aria-label="Voir {{ item.episode.title }}">{% if item.season.coverUrl %}<img src="{{ item.season.coverUrl }}" alt="Couverture de la saison {{ item.season.number }} de {{ item.series.title }}" loading="lazy">{% else %}<span aria-hidden="true">S{{ '%02d'|format(item.season.number) }}</span>{% endif %}</a><div class="calendar-card__body"><p class="eyebrow">{{ item.series.title }}</p><h2><a href="{{ path('app_series_show', {id:item.series.id, saison:item.season.number}) }}#episode-{{ item.episode.id }}">{{ item.episode.title }}</a></h2><p class="calendar-card__meta">Saison {{ item.season.number }} · Épisode {{ item.episode.number }}{% if item.episode.runtime %} · {{ item.episode.runtime }} min{% endif %}</p></div><a class="calendar-card__go" href="{{ path('app_series_show', {id:item.series.id, saison:item.season.number}) }}#episode-{{ item.episode.id }}" aria-label="Ouvrir {{ item.episode.title }}"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h13m-5-5 5 5-5 5"/></svg></a></article>{% endfor %}</div>{% else %}<div class="library-empty"><h2>Aucune sortie à venir.</h2><p class="lede">Les prochains épisodes non vus de votre bibliothèque apparaîtront ici.</p></div>{% endif %}</section>{% endblock %}
