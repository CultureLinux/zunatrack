<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="color-scheme" content="light dark">
    <title>{% block title %}ZunaTrack{% endblock %}</title>
    <script>try{const t=localStorage.getItem('zunatrack-theme');if(t&&t!=='system')document.documentElement.dataset.theme=t}catch(e){}</script>
    {{ importmap('app') }}
</head>
<body data-controller="theme">
{% if app.user %}
    {% set r = app.request.attributes.get('_route')|default('') %}
    <nav class="site-nav" aria-label="Navigation principale">
        <div class="site-header">
            <a class="site-brand" href="{{ path('app_home') }}">ZunaTrack</a>
            <div class="site-links">
                <a class="{{ r == 'app_home' ? 'is-active' }}" href="{{ path('app_home') }}">Accueil</a>
                <a class="{{ r in ['app_catalog','app_catalog_import','app_series_show'] ? 'is-active' }}" href="{{ path('app_catalog') }}">Explorer</a>
                <span>Bibliothèque</span><span>Calendrier</span>
            </div>
            <div class="site-account">
                <a class="{{ r == 'app_preferences' ? 'is-active' }}" href="{{ path('app_preferences') }}">Préférences</a>
                <button class="theme-icon" type="button" data-action="theme#toggle" aria-label="Changer de thème" title="Changer de thème"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg></button>
                <form action="{{ path('app_logout') }}" method="post"><input type="hidden" name="_token" value="{{ csrf_token('logout') }}"><button type="submit">Quitter</button></form>
            </div>
            <details class="mobile-menu">
                <summary>Menu</summary>
                <div>
                    <a href="{{ path('app_home') }}">Accueil</a><a href="{{ path('app_catalog') }}">Explorer</a><a href="{{ path('app_preferences') }}">Préférences</a>
                    <button type="button" data-action="theme#toggle" aria-label="Changer de thème"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg></button>
                </div>
            </details>
        </div>
    </nav>
{% endif %}
<main class="{{ app.user ? 'site-content' : 'auth-shell' }}">
{% for type, messages in app.flashes %}{% for message in messages %}<div class="flash flash--{{ type }}" role="status">{{ message }}</div>{% endfor %}{% endfor %}
{% block body %}{% endblock %}
</main>
</body></html>
