<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="color-scheme" content="light dark">
        <title>{% block title %}ZunaTrack{% endblock %}</title>
        {% block javascripts %}{{ importmap('app') }}{% endblock %}
    </head>
    <body>
        <main class="auth-shell">
            <a class="wordmark" href="{{ app.user ? path('app_home') : path('app_login') }}" aria-label="ZunaTrack, accueil">Zuna<span>Track</span></a>
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash--{{ label }}" role="status">{{ message }}</div>
                {% endfor %}
            {% endfor %}
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
