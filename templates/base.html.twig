<!DOCTYPE html>
<html lang="fr" data-accent="{{ app.user ? app.user.accent : 'blue' }}">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="color-scheme" content="light dark">
    <title>{% block title %}ZunaTrack{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('images/zunatrack-mark.svg') }}">
    <script>try{const t=localStorage.getItem('zunatrack-theme');if(t&&t!=='system')document.documentElement.dataset.theme=t}catch(e){}</script>
    {{ importmap('app') }}
</head>
<body data-controller="theme">
{% if app.user %}
    {% set r = app.request.attributes.get('_route')|default('') %}{% set calendarCount = calendar_upcoming_count() %}
    <nav class="site-nav" aria-label="Navigation principale">
        <div class="site-header">
            <a class="site-brand" href="{{ path('app_home') }}"><img src="{{ asset('images/zunatrack-mark.svg') }}" alt="" width="28" height="28">ZunaTrack</a>
            <div class="site-links">
                <a class="{{ r == 'app_home' ? 'is-active' }}" href="{{ path('app_home') }}">Accueil</a>
                <a class="{{ r in ['app_catalog','app_catalog_import','app_series_show'] ? 'is-active' }}" href="{{ path('app_catalog') }}">Explorer</a>
                <a class="{{ r starts with 'app_library' ? 'is-active' }}" href="{{ path('app_library') }}">Bibliothèque</a><a class="calendar-nav-link {{ r starts with 'app_calendar' ? 'is-active calendar-nav-link--active' }}" href="{{ path('app_calendar') }}">Calendrier{% if calendarCount %}<span class="calendar-nav-count" aria-label="{{ calendarCount }} épisode{{ calendarCount > 1 ? 's' }} à venir">{{ calendarCount }}</span>{% endif %}</a>
            </div>
            <div class="site-account">
                <a class="{{ r == 'app_preferences' ? 'is-active' }}" href="{{ path('app_preferences') }}">Préférences</a>
                {% if is_granted('ROLE_ADMIN') %}<a class="{{ r starts with 'app_admin_' ? 'is-active' }}" href="{{ path('app_admin_users') }}">Administration</a>{% endif %}
                {% if is_granted('IS_IMPERSONATOR') %}<a href="{{ path('app_home', {'_switch_user': '_exit'}) }}">Quitter l’usurpation</a>{% endif %}
                <button class="theme-icon" type="button" data-action="theme#toggle" aria-label="Changer de thème" title="Changer de thème"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg></button>
                <form action="{{ path('app_logout') }}" method="post"><input type="hidden" name="_token" value="{{ csrf_token('logout') }}"><button type="submit">Quitter</button></form>
            </div>
            <details class="mobile-menu">
                <summary>Menu</summary>
                <div>
                    <a href="{{ path('app_home') }}">Accueil</a><a href="{{ path('app_catalog') }}">Explorer</a><a href="{{ path('app_library') }}">Bibliothèque</a><a class="calendar-nav-link" href="{{ path('app_calendar') }}">Calendrier{% if calendarCount %}<span class="calendar-nav-count" aria-label="{{ calendarCount }} épisode{{ calendarCount > 1 ? 's' }} à venir">{{ calendarCount }}</span>{% endif %}</a><a href="{{ path('app_preferences') }}">Préférences</a>
                    {% if is_granted('IS_IMPERSONATOR') %}<a href="{{ path('app_home', {'_switch_user': '_exit'}) }}">Quitter l’usurpation</a>{% endif %}
                    <button type="button" data-action="theme#toggle" aria-label="Changer de thème"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg></button>
                </div>
            </details>
        </div>
    </nav>
{% endif %}
<main class="{{ app.user ? 'site-content' : 'auth-shell' }}">
{% if is_granted('ROLE_ADMIN') %}{% set metrics = catalog_metrics() %}<aside class="call-meter" aria-label="Compteurs catalogue">Provider {{ metrics.provider }} · Local {{ metrics.local }}</aside>{% endif %}
{% for type, messages in app.flashes %}{% for message in messages %}<div class="flash flash--{{ type }}" role="status" data-controller="toast">{{ message }}</div>{% endfor %}{% endfor %}
{% block body %}{% endblock %}
</main>
</body></html>
