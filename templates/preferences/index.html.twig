{% extends 'base.html.twig' %}
{% block title %}Préférences · ZunaTrack{% endblock %}
{% block body %}<section class="mx-auto min-h-screen max-w-3xl px-6 py-16"><p class="font-mono text-xs uppercase tracking-[.25em] text-accent">Votre espace</p><h1 class="mt-4 font-serif text-5xl text-foreground">Préférences</h1><form class="mt-10 grid gap-6 border border-line bg-surface p-6" method="post"><input type="hidden" name="_token" value="{{ csrf_token('preferences') }}"><label class="flex flex-wrap items-center justify-between gap-3">Langue <select class="min-w-40 max-w-full px-3 py-2" name="locale"><option value="fr" {{ user.locale=='fr'?'selected' }}>Français</option><option value="en" {{ user.locale=='en'?'selected' }}>English</option></select></label><label class="flex flex-wrap items-center justify-between gap-3">Thème <select class="min-w-40 max-w-full px-3 py-2" name="theme"><option value="system" {{ user.theme=='system'?'selected' }}>Système</option><option value="light" {{ user.theme=='light'?'selected' }}>Clair</option><option value="dark" {{ user.theme=='dark'?'selected' }}>Sombre</option></select></label><label class="flex flex-wrap items-center justify-between gap-3">Densité <select class="min-w-40 max-w-full px-3 py-2" name="density"><option value="compact" {{ user.density=='compact'?'selected' }}>Compacte</option><option value="normal" {{ user.density=='normal'?'selected' }}>Normale</option><option value="reading" {{ user.density=='reading'?'selected' }}>Lecture</option></select></label><label class="flex flex-wrap items-center justify-between gap-3">Taille <select class="min-w-40 max-w-full px-3 py-2" name="fontSize"><option value="small" {{ user.fontSize=='small'?'selected' }}>Petite</option><option value="normal" {{ user.fontSize=='normal'?'selected' }}>Normale</option><option value="large" {{ user.fontSize=='large'?'selected' }}>Grande</option></select></label><label class="flex flex-wrap items-center justify-between gap-3">Accent <select class="min-w-40 max-w-full px-3 py-2" name="accent"><option value="blue" {{ user.accent=='blue'?'selected' }}>Bleu acier</option><option value="rose" {{ user.accent=='rose'?'selected' }}>Rose</option><option value="emerald" {{ user.accent=='emerald'?'selected' }}>Émeraude</option><option value="amber" {{ user.accent=='amber'?'selected' }}>Ambre</option></select></label><button class="inline-flex items-center justify-center gap-2 border border-accent px-4 py-3 text-accent hover:bg-accent-soft" name="save_preferences">Enregistrer</button></form><section class="mt-10 border border-line bg-surface p-6"><p class="font-mono text-xs uppercase tracking-[.25em] text-accent">Sécurité</p><h2 class="mt-3 font-serif text-2xl text-foreground">Changer le mot de passe</h2><form method="post" class="mt-6 grid max-w-md gap-4"><input type="hidden" name="_token" value="{{ csrf_token('preferences') }}"><label class="grid gap-2">Mot de passe actuel<input class="px-3 py-2" name="current_password" type="password" autocomplete="current-password" required></label><label class="grid gap-2">Nouveau mot de passe<input class="px-3 py-2" name="new_password" type="password" autocomplete="new-password" minlength="12" required></label><button class="inline-flex items-center justify-center border border-line px-4 py-3 text-accent hover:border-accent hover:bg-accent-soft" name="change_password">Modifier le mot de passe</button></form></section></section>{% endblock %}
