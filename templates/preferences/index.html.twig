{% extends 'base.html.twig' %}
{% block title %}Préférences · ZunaTrack{% endblock %}
{% block body %}
<section class="preferences-page" aria-labelledby="page-title">
    <header class="page-header"><p class="eyebrow">Votre espace</p><h1 id="page-title">Préférences</h1><p class="lede">Personnalisez l’affichage et sécurisez votre compte.</p></header>
    <form class="form-card form-stack form-stack--settings" method="post"><input type="hidden" name="_token" value="{{ csrf_token('preferences') }}"><label class="form-field">Langue <select name="locale"><option value="fr" {{ user.locale=='fr'?'selected' }}>Français</option><option value="en" {{ user.locale=='en'?'selected' }}>English</option></select></label><label class="form-field" data-controller="accent-preview">Accent <span class="accent-picker"><span class="accent-swatch" data-accent-preview-target="swatch" data-accent="{{ user.accent }}" aria-hidden="true"></span><select name="accent" data-accent-preview-target="select" data-action="change->accent-preview#preview"><option value="cyan" {{ user.accent=='cyan'?'selected' }}>Cyan</option><option value="orange" {{ user.accent=='orange'?'selected' }}>Orange</option><option value="emerald" {{ user.accent=='emerald'?'selected' }}>Émeraude</option><option value="blue" {{ user.accent=='blue'?'selected' }}>Bleu</option><option value="violet" {{ user.accent=='violet'?'selected' }}>Violet</option><option value="rose" {{ user.accent=='rose'?'selected' }}>Rose</option><option value="red" {{ user.accent=='red'?'selected' }}>Rouge</option><option value="amber" {{ user.accent=='amber'?'selected' }}>Ambre</option><option value="lime" {{ user.accent=='lime'?'selected' }}>Vert citron</option><option value="slate" {{ user.accent=='slate'?'selected' }}>Ardoise</option></select></span></label><div class="form-actions"><button class="button button--primary" name="save_preferences">Enregistrer</button></div></form>
    {% if pushPublicKey %}<meta name="csrf-push-subscription" content="{{ csrf_token('push-subscription') }}"><section class="form-card push-panel" data-push-subscription data-public-key="{{ pushPublicKey }}" data-url="{{ path('app_push_subscription') }}"><p class="eyebrow">Notifications</p><h2>Alertes de diffusion</h2><p>Recevez les épisodes diffusés de vos séries suivies sur cet appareil.</p><div class="push-actions"><button class="button button--primary" type="button" data-push-enable>Activer sur cet appareil</button><button class="button" type="button" data-push-test hidden>Tester la notification</button><button class="button" type="button" data-push-disable hidden>Désactiver cet appareil</button></div><p role="status" data-push-status></p>{% if pushDevices %}<h3>Appareils enregistrés</h3><ul class="push-devices">{% for device in pushDevices %}<li><strong>{{ device.userAgent ?: 'Navigateur inconnu' }}</strong><small>Activé le {{ device.activatedAt|date('d/m/Y H:i') }}</small></li>{% endfor %}</ul>{% endif %}</section><script src="{{ asset('push.js') }}" defer></script>{% endif %}
    {% include 'preferences/_data_transfer.html.twig' %}
    <section class="form-card"><p class="eyebrow">Sécurité</p><h2>Changer le mot de passe</h2><form method="post" class="form-stack form-stack--password"><input type="hidden" name="_token" value="{{ csrf_token('preferences') }}"><label class="form-field">Mot de passe actuel<input name="current_password" type="password" autocomplete="current-password" required></label><label class="form-field">Nouveau mot de passe<input name="new_password" type="password" autocomplete="new-password" minlength="12" required></label><div class="form-actions"><button class="button" name="change_password">Modifier le mot de passe</button></div></form></section>
</section>{% endblock %}
