{% extends 'base.html.twig' %}
{% block title %}Préférences · ZunaTrack{% endblock %}
{% block body %}
<section class="preferences-page" aria-labelledby="page-title">
    <header class="page-header"><p class="eyebrow">Votre espace</p><h1 id="page-title">Préférences</h1><p class="lede">Personnalisez l’affichage et sécurisez votre compte.</p></header>
    <form class="form-card form-stack form-stack--settings" method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('preferences') }}">
        <label class="form-field">Langue
            <select name="locale"><option value="fr" {{ user.locale=='fr'?'selected' }}>Français</option><option value="en" {{ user.locale=='en'?'selected' }}>English</option></select>
        </label>
        <label class="form-field" data-controller="accent-preview">Accent
            <span class="accent-picker"><span class="accent-swatch" data-accent-preview-target="swatch" data-accent="{{ user.accent }}" aria-hidden="true"></span><select name="accent" data-accent-preview-target="select" data-action="change->accent-preview#preview"><option value="blue" {{ user.accent=='blue'?'selected' }}>Bleu acier</option><option value="rose" {{ user.accent=='rose'?'selected' }}>Rose</option><option value="emerald" {{ user.accent=='emerald'?'selected' }}>Émeraude</option><option value="amber" {{ user.accent=='amber'?'selected' }}>Ambre</option></select></span>
        </label>
        <div class="form-actions"><button class="button button--primary" name="save_preferences">Enregistrer</button></div>
    </form>
    <section class="form-card">
        <p class="eyebrow">Sécurité</p><h2>Changer le mot de passe</h2>
        <form method="post" class="form-stack form-stack--password"><input type="hidden" name="_token" value="{{ csrf_token('preferences') }}"><label class="form-field">Mot de passe actuel<input name="current_password" type="password" autocomplete="current-password" required></label><label class="form-field">Nouveau mot de passe<input name="new_password" type="password" autocomplete="new-password" minlength="12" required></label><div class="form-actions"><button class="button" name="change_password">Modifier le mot de passe</button></div></form>
    </section>
</section>
{% endblock %}
