{% extends 'base.html.twig' %}
{% block title %}{{ series.title }} · ZunaTrack{% endblock %}
{% block body %}<article class="series-detail">{% if series.posterUrl %}<img class="series-poster" src="{{ series.posterUrl }}" alt="Affiche de {{ series.title }}">{% endif %}<div><p class="eyebrow">{{ series.status ?: 'Série TV' }}</p><h1>{{ series.title }}</h1><p class="lede">{{ series.summary ?: 'Aucun résumé disponible.' }}</p><p class="chips">{% for genre in series.genres %}<span>{{ genre }}</span>{% endfor %}</p>{% if entry %}<span class="library-status">Dans ma bibliothèque · {{ constant('App\\Entity\\LibraryEntry::STATUSES')[entry.status] }}</span>{% else %}<form method="post" action="{{ path('app_library_add', {id: series.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('library_add_' ~ series.id) }}"><button class="button button--primary" type="submit">Ajouter à ma bibliothèque</button></form>{% endif %}<p><a href="{{ path('app_catalog') }}">← Retour au catalogue</a></p></div></article>{% if entry %}<section class="library-editor" aria-labelledby="library-title"><div><p class="eyebrow">Ma bibliothèque</p><h2 id="library-title">Votre fiche de suivi</h2></div><form method="post" action="{{ path('app_library_update', {id: entry.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('library_update_' ~ entry.id) }}"><div class="library-fields"><label for="status">Statut<select id="status" name="status">{% for value, label in constant('App\\Entity\\LibraryEntry::STATUSES') %}<option value="{{ value }}" {{ entry.status == value ? 'selected' }}>{{ label }}</option>{% endfor %}</select></label><label for="started_at">Commencée le<input id="started_at" type="date" name="started_at" value="{{ entry.startedAt ? entry.startedAt|date('Y-m-d') }}"></label><label for="finished_at">Terminée le<input id="finished_at" type="date" name="finished_at" value="{{ entry.finishedAt ? entry.finishedAt|date('Y-m-d') }}"></label><label class="library-note" for="note">Note personnelle<textarea id="note" name="note" rows="4" maxlength="5000" placeholder="Une impression, un rappel…">{{ entry.note }}</textarea></label></div><button class="button button--primary" type="submit">Enregistrer ma fiche</button></form><form method="post" action="{{ path('app_library_remove', {id: entry.id}) }}" onsubmit="return confirm('Retirer cette série de votre bibliothèque ?');"><input type="hidden" name="_token" value="{{ csrf_token('library_remove_' ~ entry.id) }}"><button class="link-button" type="submit">Retirer de ma bibliothèque</button></form></section>{% endif %}<section class="season-list" aria-labelledby="seasons-title"><h2 id="seasons-title">Saisons et épisodes</h2>{% for season in series.seasons %}<details><summary>Saison {{ season.number }}{{ season.name ? ' · '~season.name : '' }} <span>{{ season.episodes|length }} épisodes</span></summary><ol>{% for episode in season.episodes %}<li><strong>{{ episode.number }}. {{ episode.title }}</strong>{% if episode.airDate %}<time datetime="{{ episode.airDate|date('Y-m-d') }}">{{ episode.airDate|date('d/m/Y') }}</time>{% endif %}</li>{% endfor %}</ol></details>{% else %}<p>Aucune saison disponible.</p>{% endfor %}</section>{% endblock %}
