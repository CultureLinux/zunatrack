{% extends 'base.html.twig' %}
{% block title %}{{ series.title }} · ZunaTrack{% endblock %}
{% block body %}<article class="series-detail">{% if series.posterUrl %}<img class="series-poster" src="{{ series.posterUrl }}" alt="Affiche de {{ series.title }}">{% endif %}<div><p class="eyebrow">{{ series.status ?: 'Série TV' }}</p><h1>{{ series.title }}</h1><p class="lede">{{ series.summary ?: 'Aucun résumé disponible.' }}</p><p class="chips">{% for genre in series.genres %}<span>{{ genre }}</span>{% endfor %}</p><a href="{{ path('app_catalog') }}">← Retour au catalogue</a></div></article><section class="season-list" aria-labelledby="seasons-title"><h2 id="seasons-title">Saisons et épisodes</h2>{% for season in series.seasons %}<details><summary>Saison {{ season.number }}{{ season.name ? ' · '~season.name : '' }} <span>{{ season.episodes|length }} épisodes</span></summary><ol>{% for episode in season.episodes %}<li><strong>{{ episode.number }}. {{ episode.title }}</strong>{% if episode.airDate %}<time datetime="{{ episode.airDate|date('Y-m-d') }}">{{ episode.airDate|date('d/m/Y') }}</time>{% endif %}</li>{% endfor %}</ol></details>{% else %}<p>Aucune saison disponible.</p>{% endfor %}</section>{% endblock %}
