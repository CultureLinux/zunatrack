{% extends 'base.html.twig' %}
{% block title %}{{ series.title }} · ZunaTrack{% endblock %}
{% block body %}
<article class="series-detail" {% if entry %}data-controller="modal"{% endif %}>
<div class="series-cover">{% if selectedSeasonEntity and selectedSeasonEntity.coverUrl %}<img class="series-poster" src="{{ selectedSeasonEntity.coverUrl }}" alt="Couverture de la saison {{ selectedSeasonEntity.number }}">{% elseif series.posterUrl %}<img class="series-poster" src="{{ series.posterUrl }}" alt="Affiche de {{ series.title }}">{% endif %}{% if entry and selectedSeasonEntity %}<button class="button" type="button" data-action="modal#open">Ma fiche · {{ constant('App\\Entity\\LibraryEntry::STATUSES')[entry.status] }}</button>{% endif %}</div>
<div class="series-summary">{% if selectedSeasonEntity %}<p class="eyebrow">{{ series.title }}</p><h1>Saison {{ selectedSeasonEntity.number }}</h1><p class="lede">{{ selectedSeasonEntity.episodes|length }} épisodes</p>{% if seasonPayload.summary|default %}<p class="season-summary">{{ seasonPayload.summary|striptags }}</p>{% endif %}{% else %}<p class="eyebrow">{{ series.status ?: 'Série TV' }}</p><h1>{{ series.title }}</h1><p class="lede">{{ series.summary ?: 'Aucun résumé disponible.' }}</p><p class="chips">{% for genre in series.genres %}<span>{{ genre }}</span>{% endfor %}</p>{% endif %}
{% if entry and not selectedSeasonEntity %}<button class="button" type="button" data-action="modal#open">Ma fiche · {{ constant('App\\Entity\\LibraryEntry::STATUSES')[entry.status] }}</button>{% elseif not entry %}<form method="post" action="{{ path('app_library_add', {id: series.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('library_add_' ~ series.id) }}"><button class="button button--primary" type="submit">Ajouter à ma bibliothèque</button></form>{% endif %}
{% if selectedSeasonEntity %}<nav class="season-navigation" aria-label="Navigation des saisons"><a class="button" href="{{ path('app_series_show',{id:series.id}) }}">← Retour à la série</a>{% if nextSeason %}<a class="button button--primary" href="{{ path('app_series_show',{id:series.id,saison:nextSeason.number}) }}">Aller à la saison {{ nextSeason.number }} →</a>{% endif %}</nav>{% else %}<p><a href="{{ path('app_catalog') }}">← Retour au catalogue</a></p>{% endif %}</div>
{% if entry %}<dialog class="library-modal" aria-labelledby="library-title" data-modal-target="dialog" data-action="click->modal#backdrop"><div class="library-modal__header"><div><p class="eyebrow">Ma bibliothèque</p><h2 id="library-title">Votre fiche de suivi</h2></div><button class="modal-close" type="button" data-action="modal#close" aria-label="Fermer la fiche">×</button></div><form method="post" action="{{ path('app_library_update', {id: entry.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('library_update_' ~ entry.id) }}"><div class="library-fields"><label for="status">Statut<select id="status" name="status">{% for value, label in constant('App\\Entity\\LibraryEntry::STATUSES') %}<option value="{{ value }}" {{ entry.status == value ? 'selected' }}>{{ label }}</option>{% endfor %}</select></label><label for="started_at">Commencée le<input id="started_at" type="date" name="started_at" value="{{ entry.startedAt ? entry.startedAt|date('Y-m-d') }}"></label><label for="finished_at">Terminée le<input id="finished_at" type="date" name="finished_at" value="{{ entry.finishedAt ? entry.finishedAt|date('Y-m-d') }}"></label><label class="library-note" for="note">Note personnelle<textarea id="note" name="note" rows="4" maxlength="5000">{{ entry.note }}</textarea></label></div><div class="form-actions"><button class="button button--primary" type="submit">Enregistrer ma fiche</button></div></form><form method="post" action="{{ path('app_library_remove', {id: entry.id}) }}" onsubmit="return confirm('Retirer cette série de votre bibliothèque ?');"><input type="hidden" name="_token" value="{{ csrf_token('library_remove_' ~ entry.id) }}"><button class="link-button" type="submit">Retirer de ma bibliothèque</button></form></dialog>{% endif %}
</article>
{% if not selectedSeasonEntity %}<section class="season-list"><header class="page-header"><p class="eyebrow">Catalogue</p><h2>Saisons et épisodes</h2></header><div class="season-grid">{% for season in series.seasons %}<article class="season-card"><a class="season-card__link" href="{{ path('app_series_show',{id:series.id,saison:season.number}) }}">{% if season.coverUrl %}<img src="{{ season.coverUrl }}" alt="Couverture de la saison {{ season.number }}" loading="lazy">{% else %}<span class="season-placeholder">S{{ season.number }}</span>{% endif %}<span><strong>Saison {{ season.number }}</strong><small>{{ season.name ?: season.episodes|length ~ ' épisodes' }}</small></span></a></article>{% endfor %}</div></section>{% endif %}
{% if selectedSeasonEntity %}<section class="episode-panel" aria-labelledby="episodes-title"><h2 id="episodes-title">Épisodes</h2><div class="episode-grid">{% for episode in selectedSeasonEntity.episodes %}<article class="episode-card">{% if episode.coverUrl %}<img src="{{ episode.coverUrl }}" alt="Image de l’épisode {{ episode.number }} : {{ episode.title }}" loading="lazy">{% else %}<span class="episode-placeholder">É{{ episode.number }}</span>{% endif %}<div><p class="eyebrow">Épisode {{ episode.number }}{% if episode.runtime %} · {{ episode.runtime }} min{% endif %}</p><h3>{{ episode.title }}</h3>{% if episode.summary %}<p class="episode-summary">{{ episode.summary }}</p>{% endif %}{% if episode.airDate %}<time datetime="{{ episode.airDate|date('Y-m-d') }}">Diffusé le {{ episode.airDate|date('d/m/Y') }}</time>{% endif %}</div></article>{% endfor %}</div></section>{% endif %}
{% endblock %}
