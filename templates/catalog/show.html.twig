{% extends 'base.html.twig' %}
{% block title %}{{ series.title }} · ZunaTrack{% endblock %}
{% block body %}
<section {% if entry %}data-controller="modal watch-toggle"{% endif %}><article class="series-detail">
 <div class="series-cover"><div class="cover-frame">{% if selectedSeasonEntity and selectedSeasonEntity.coverUrl %}<img class="series-poster" src="{{ selectedSeasonEntity.coverUrl }}" alt="Couverture de la saison {{ selectedSeasonEntity.number }}">{% elseif series.posterUrl %}<img class="series-poster" src="{{ series.posterUrl }}" alt="Affiche de {{ series.title }}">{% endif %}{% set progress = selectedSeasonEntity ? seasonProgress[selectedSeasonEntity.number] : seriesProgress %}{% if entry and progress %}{% if progress.complete %}<span class="watched-mark" aria-label="Entièrement vu">✓</span>{% endif %}<span class="cover-progress" style="--progress:{{ progress.percent }}%"><span>{{ progress.watched }}/{{ progress.total }}</span></span>{% endif %}</div></div>
 <div class="series-summary">{% if selectedSeasonEntity %}<p class="eyebrow">{{ series.title }}</p><h1>{{ selectedSeasonEntity.number == 0 ? 'Spéciaux' : 'Saison ' ~ selectedSeasonEntity.number }}</h1><p class="lede">{{ seasonProgress[selectedSeasonEntity.number].watched|default(0) }}/{{ seasonProgress[selectedSeasonEntity.number].total|default(0) }} épisodes diffusés vus</p>{% else %}<p class="eyebrow">{{ series.status ?: 'Série TV' }}</p><h1>{{ series.title }}</h1><p class="lede">{{ series.summary ?: 'Aucun résumé disponible.' }}</p>{% if entry and nextEpisode %}<p class="resume-card">Reprendre · <a href="{{ path('app_series_show',{id:series.id,saison:nextEpisode.season.number}) }}">S{{ '%02d'|format(nextEpisode.season.number) }}E{{ '%02d'|format(nextEpisode.episode.number) }} — {{ nextEpisode.episode.title }}</a></p>{% endif %}{% endif %}
 {% if entry %}<form class="inline-toggle" method="post" action="{{ path('app_library_progress',{id:entry.id,type:selectedSeasonEntity ? 'season' : 'series',target:selectedSeasonEntity ? selectedSeasonEntity.id : series.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('library_progress_' ~ entry.id) }}"><input type="hidden" name="watched" value="{{ progress.complete ? '0' : '1' }}"><button class="button button--primary" type="submit" aria-pressed="{{ progress.complete ? 'true' : 'false' }}">{{ progress.complete ? 'Vu · annuler' : selectedSeasonEntity ? 'Marquer la saison comme vue' : 'Marquer toute la série comme vue' }}</button></form>{% else %}<form method="post" action="{{ path('app_library_add',{id:series.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('library_add_' ~ series.id) }}"><button class="button button--primary">Ajouter à ma bibliothèque</button></form>{% endif %}
 {% if selectedSeasonEntity %}<nav class="season-navigation"><a class="button" href="{{ path('app_series_show',{id:series.id}) }}">← Retour à la série</a>{% if nextSeason %}<a class="button button--primary" href="{{ path('app_series_show',{id:series.id,saison:nextSeason.number}) }}">Saison {{ nextSeason.number }} →</a>{% endif %}</nav>{% endif %}</div>
</article>
{% if entry %}<dialog class="library-modal" data-modal-target="dialog" aria-labelledby="library-title"><div class="library-modal__header"><h2 id="library-title">Votre fiche de suivi</h2><button class="modal-close" type="button" data-action="modal#close" aria-label="Fermer">×</button></div><form method="post" action="{{ path('app_library_update',{id:entry.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('library_update_' ~ entry.id) }}"><div class="library-fields"><label>Statut<select name="status">{% for value,label in constant('App\\Entity\\LibraryEntry::STATUSES') %}<option value="{{ value }}" {{ entry.status == value ? 'selected' }}>{{ label }}</option>{% endfor %}</select></label><label>Commencée le<input type="date" name="started_at" value="{{ entry.startedAt ? entry.startedAt|date('Y-m-d') }}"></label><label>Terminée le<input type="date" name="finished_at" value="{{ entry.finishedAt ? entry.finishedAt|date('Y-m-d') }}"></label><label class="library-note">Note personnelle<textarea name="note">{{ entry.note }}</textarea></label></div><button class="button button--primary" type="submit">Enregistrer ma fiche</button></form><form method="post" action="{{ path('app_library_remove',{id:entry.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('library_remove_' ~ entry.id) }}"><button class="link-button" type="submit">Retirer de ma bibliothèque</button></form></dialog>{% endif %}
{% if not entry %}<dialog class="library-modal" data-modal-target="dialog" hidden></dialog>{% endif %}
{% if not selectedSeasonEntity %}<section class="season-list"><header class="page-header"><p class="eyebrow">Catalogue</p><h2>Saisons et épisodes</h2>{% if entry %}<p class="lede">Progression basée sur les épisodes diffusés. Les spéciaux restent séparés.</p>{% endif %}</header><div class="season-grid">{% for season in series.seasons %}<article class="season-card"><a class="season-card__link" href="{{ path('app_series_show',{id:series.id,saison:season.number}) }}"><div class="cover-frame">{% if season.coverUrl %}<img src="{{ season.coverUrl }}" alt="Couverture de la saison {{ season.number }}">{% else %}<span class="season-placeholder">S{{ season.number }}</span>{% endif %}{% if entry %}{% set p=seasonProgress[season.number] %}{% if p.complete %}<span class="watched-mark">✓</span>{% endif %}<span class="cover-progress" style="--progress:{{ p.percent }}%"><span>{{ p.watched }}/{{ p.total }}</span></span>{% endif %}</div><span><strong>{{ season.number == 0 ? 'Spéciaux' : 'Saison ' ~ season.number }}</strong><small>{{ season.episodes|length }} épisodes</small></span></a></article>{% endfor %}</div></section>{% endif %}
{% if selectedSeasonEntity %}<section class="episode-panel"><h2>Épisodes</h2><div class="episode-grid">{% for episode in selectedSeasonEntity.episodes %}<article class="episode-card {{ watchedEpisodes[episode.id]|default ? 'is-watched' }}">{% if episode.coverUrl %}<img src="{{ episode.coverUrl }}" alt="Image de l’épisode {{ episode.number }} : {{ episode.title }}">{% else %}<span class="episode-placeholder">É{{ episode.number }}</span>{% endif %}<div><p class="eyebrow">Épisode {{ episode.number }}{% if episode.runtime %} · {{ episode.runtime }} min{% endif %}</p><h3>{{ episode.title }}</h3>{% if episode.summary %}<p class="episode-summary">{{ episode.summary }}</p>{% endif %}</div>{% if entry %}<form class="episode-toggle" method="post" action="{{ path('app_library_progress',{id:entry.id,type:'episode',target:episode.id}) }}" {% if not watchedEpisodes[episode.id]|default and episode.number > 1 %}data-action="submit->watch-toggle#confirm"{% endif %}><input type="hidden" name="_token" value="{{ csrf_token('library_progress_' ~ entry.id) }}"><input type="hidden" name="watched" value="{{ watchedEpisodes[episode.id]|default ? '0' : '1' }}"><input type="hidden" name="catch_up" value="0"><button type="submit" aria-pressed="{{ watchedEpisodes[episode.id]|default ? 'true' : 'false' }}" aria-label="{{ watchedEpisodes[episode.id]|default ? 'Marquer non vu' : 'Marquer vu' }}"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"></path></svg></button></form>{% endif %}</article>{% endfor %}</div></section>{% endif %}
{% if entry %}<dialog class="catchup-dialog" data-watch-toggle-target="dialog"><h2>Mettre la progression à jour ?</h2><p>Marquer seulement cet épisode, ou également les précédents de cette saison ?</p><div><button type="button" data-action="watch-toggle#only">Seulement cet épisode</button><button class="button button--primary" type="button" data-action="watch-toggle#catchUp">Les précédents + cet épisode</button><button type="button" data-action="watch-toggle#cancel">Annuler</button></div></dialog>{% endif %}</section>
{% endblock %}
