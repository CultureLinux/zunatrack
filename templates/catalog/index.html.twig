{% extends 'base.html.twig' %}
{% block title %}Catalogue · ZunaTrack{% endblock %}
{% block body %}<section class="catalog" aria-labelledby="page-title"><p class="eyebrow">Catalogue · TVmaze</p><h1 id="page-title">Trouvez votre<br>prochaine série.</h1><form class="catalog-search" method="get"><label for="q">Nom de la série</label><input id="q" name="q" value="{{ query }}" type="search" required autocomplete="off" placeholder="Ex. Severance"><button class="button button--primary">Rechercher</button></form>{% if query %}<p class="result-count">{{ results|length }} résultat{{ results|length > 1 ? 's' : '' }} pour « {{ query }} »</p><div class="result-grid">{% for result in results %}<article class="result-card {{ not result.posterUrl ? 'result-card--without-poster' }}">{% if result.posterUrl %}<img src="{{ result.posterUrl }}" alt="Affiche de {{ result.title }}" loading="lazy">{% endif %}<div><p class="eyebrow">{{ result.premiered ? result.premiered|date('Y') : 'Série TV' }}</p><h2>{{ result.title }}</h2><p>{{ result.summary ?: 'Aucun résumé disponible.' }}</p><a href="{{ path('app_catalog_import',{id:result.id}) }}">Voir les détails <span aria-hidden="true">→</span></a></div></article>{% else %}<p class="lede">Aucune série trouvée. Essayez un titre plus court.</p>{% endfor %}</div>{% endif %}</section>{% endblock %}
