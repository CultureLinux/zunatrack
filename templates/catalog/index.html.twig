{% extends 'base.html.twig' %}
{% block title %}Catalogue · ZunaTrack{% endblock %}
{% block body %}
<section class="catalog" aria-labelledby="page-title">
    <div class="catalog-intro"><header class="page-header"><p class="eyebrow">{{ actor ? 'Distribution locale' : 'Catalogue · TVmaze' }}</p><h1 id="page-title">{{ actor ? 'Séries avec ' ~ actor : 'Explorer les séries' }}</h1><p class="lede">{{ actor ? 'Toutes les séries déjà importées dans ZunaTrack où cette personne apparaît.' : 'Recherchez une série, consultez ses détails et ajoutez-la à votre bibliothèque.' }}</p></header><form class="catalog-search" method="get"><label for="q">Nom de la série</label><input id="q" name="q" value="{{ query }}" type="search" required autocomplete="off" placeholder="Ex. Severance"><button class="button button--primary">Rechercher</button></form></div>
    {% if actor %}<p class="result-count">{{ results|length }} série{{ results|length > 1 ? 's' : '' }} avec {{ actor }}</p>{% elseif query %}<p class="result-count">{{ results|length }} résultat{{ results|length > 1 ? 's' : '' }} pour « {{ query }} »</p>{% endif %}
    {% if actor or query %}<div class="result-grid">{% for result in results %}<article class="result-card {{ not result.posterUrl ? 'result-card--without-poster' }}">{% if result.posterUrl %}<img src="{{ result.posterUrl }}" alt="Affiche de {{ result.title }}" loading="lazy">{% endif %}<div><p class="eyebrow">{{ result.premieredAt is defined ? (result.premieredAt ? result.premieredAt|date('Y') : 'Série TV') : (result.premiered ? result.premiered|date('Y') : 'Série TV') }}</p><h2>{{ result.title }}</h2><p>{{ result.summary ?: 'Aucun résumé disponible.' }}</p><a href="{{ actor ? path('app_series_show',{id:result.id}) : path('app_catalog_import',{id:result.id}) }}">Voir les détails <span aria-hidden="true">→</span></a></div></article>{% else %}<p class="lede">{{ actor ? 'Aucune autre série importée ne contient cette personne.' : 'Aucune série trouvée. Essayez un titre plus court.' }}</p>{% endfor %}</div>
    {% elseif suggestionGroups %}{% for group in suggestionGroups %}<section class="catalog-suggestions" aria-label="{{ group.title }}" data-controller="catalog-carousel" data-action="mouseenter->catalog-carousel#pause mouseleave->catalog-carousel#resume focusin->catalog-carousel#pause focusout->catalog-carousel#resume"><p class="eyebrow">{{ group.title }}</p><div class="catalog-carousel"><button class="catalog-carousel__control" type="button" data-action="catalog-carousel#previous" aria-label="Séries précédentes">‹</button><div class="catalog-suggestion-grid" data-catalog-carousel-target="track">{% for series in group.series %}<a class="catalog-suggestion" href="{{ path('app_series_show',{id:series.id}) }}">{% if series.posterUrl %}<img src="{{ series.posterUrl }}" alt="Affiche de {{ series.title }}" loading="lazy">{% else %}<img src="{{ asset('images/zunatrack-mark.svg') }}" alt="" class="catalog-suggestion__placeholder" aria-hidden="true">{% endif %}<span>{{ series.title }}</span></a>{% endfor %}</div><button class="catalog-carousel__control" type="button" data-action="catalog-carousel#next" aria-label="Séries suivantes">›</button></div></section>{% endfor %}
    {% else %}<p class="lede catalog-empty">Recherchez une série pour commencer à composer votre catalogue local.</p>{% endif %}
</section>
{% endblock %}
