{% extends 'base.html.twig' %}
{% block title %}Ma bibliothèque · ZunaTrack{% endblock %}
{% block body %}<section class="library" aria-labelledby="page-title"><p class="eyebrow">Collection personnelle</p><h1 id="page-title">Ma bibliothèque</h1><form class="library-filters" method="get" data-controller="library-filter"><label for="q">Rechercher</label><input id="q" name="q" type="search" value="{{ query }}" placeholder="Titre de série" data-action="input->library-filter#search"><label for="status">Statut</label><select id="status" name="status" data-action="change->library-filter#submit"><option value="">Tous les statuts</option>{% for value, label in statuses %}<option value="{{ value }}" {{ status == value ? 'selected' }}>{{ label }}</option>{% endfor %}</select></form>{% if entries %}<p class="result-count">{{ entries|length }} série{{ entries|length > 1 ? 's' : '' }} dans cette vue.</p><div class="library-grid">{% for entry in entries %}<article class="library-card">{% if entry.series.posterUrl %}<img src="{{ entry.series.posterUrl }}" alt="Affiche de {{ entry.series.title }}" loading="lazy">{% endif %}<div><p class="eyebrow">{{ statuses[entry.status] }}</p><h2><a href="{{ path('app_series_show', {id: entry.series.id}) }}">{{ entry.series.title }}</a></h2>{% if entry.note %}<p>{{ entry.note|slice(0, 160) }}{{ entry.note|length > 160 ? '…' }}</p>{% endif %}<dl><div><dt>Ajoutée</dt><dd>{{ entry.addedAt|date('d/m/Y') }}</dd></div>{% if entry.startedAt %}<div><dt>Commencée</dt><dd>{{ entry.startedAt|date('d/m/Y') }}</dd></div>{% endif %}{% if entry.finishedAt %}<div><dt>Terminée</dt><dd>{{ entry.finishedAt|date('d/m/Y') }}</dd></div>{% endif %}</dl></div></article>{% endfor %}</div>{% else %}<div class="library-empty"><h2>Votre bibliothèque attend sa première série.</h2><p class="lede">Explorez le catalogue, puis ajoutez les séries que vous souhaitez suivre.</p><a class="button button--primary" href="{{ path('app_catalog') }}">Explorer le catalogue</a></div>{% endif %}</section>{% endblock %}
