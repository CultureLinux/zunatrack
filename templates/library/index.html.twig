{% extends 'base.html.twig' %}
{% block title %}Ma bibliothèque · ZunaTrack{% endblock %}
{% block body %}
<section class="library" aria-labelledby="page-title"><header class="page-header"><p class="eyebrow">Collection personnelle</p><h1 id="page-title">Bibliothèque</h1><p class="lede">Vos séries, vos statuts et votre progression au même endroit.</p></header>
<form class="library-filters library-toolbar" method="get" data-controller="library-filter"><select name="status" aria-label="Filtrer par statut" data-action="change->library-filter#submit"><option value="">Tous les statuts</option>{% for value,label in statuses %}<option value="{{ value }}" {{ status == value ? 'selected' }}>{{ label }}</option>{% endfor %}</select><select name="genre" aria-label="Filtrer par genre" data-action="change->library-filter#submit"><option value="">Tous les genres</option>{% for value in genres %}<option value="{{ value }}" {{ selectedGenre == value ? 'selected' }}>{{ value }}</option>{% endfor %}</select><select name="network" aria-label="Filtrer par réseau" data-action="change->library-filter#submit"><option value="">Tous les réseaux</option>{% for value in networkOptions %}<option value="{{ value }}" {{ selectedNetwork == value ? 'selected' }}>{{ value }}</option>{% endfor %}</select><div class="library-search"><input name="q" type="search" value="{{ query }}" placeholder="Rechercher une série" aria-label="Rechercher une série" data-library-filter-target="query" data-action="input->library-filter#search"></div></form>
{% if entries %}<div class="library-grid">{% for entry in entries %}{% set progress=progresses[entry.id] %}<article class="library-card"><div class="library-card__cover">{% if entry.series.posterUrl %}<img src="{{ entry.series.posterUrl }}" alt="Affiche de {{ entry.series.title }}" loading="lazy">{% endif %}<span class="library-card__progress" style="--progress:{{ progress.percent }}%"><i></i><b>{{ progress.watched }}/{{ progress.total }}</b></span></div><div class="library-card__main"><p class="eyebrow">{{ statuses[entry.status] }}</p><h2><a href="{{ path('app_series_show',{id:entry.series.id}) }}">{{ entry.series.title }}</a></h2><p class="library-summary">{{ entry.series.summary ? entry.series.summary|striptags|slice(0,360) ~ (entry.series.summary|length > 360 ? '…') : 'Aucun résumé disponible.' }}</p><div class="library-tags">{% for genre in genresBySeries[entry.series.id] %}<span>{{ genre }}</span>{% endfor %}{% if networks[entry.series.id] %}<span>{{ networks[entry.series.id] }}</span>{% endif %}</div><form class="status-actions" method="post" action="{{ path('app_library_status',{id:entry.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('library_status_' ~ entry.id) }}"><span>Statut</span>{% for value,label in statuses %}<button type="submit" name="status" value="{{ value }}" {{ entry.status == value ? 'aria-pressed="true"' : 'aria-pressed="false"' }}>{{ label }}</button>{% endfor %}</form></div><dl><div><dt>Saisons</dt><dd>{{ entry.series.seasons|length }}</dd></div><div><dt>Progression</dt><dd>{{ progress.watched }}/{{ progress.total }}</dd></div><div><dt>Ajoutée</dt><dd>{{ entry.addedAt|date('d/m/Y') }}</dd></div></dl></article>{% endfor %}</div>{% else %}<div class="library-empty"><h2>Votre bibliothèque attend sa première série.</h2><p class="lede">Explorez le catalogue, puis ajoutez les séries que vous souhaitez suivre.</p><a class="button button--primary" href="{{ path('app_catalog') }}">Explorer le catalogue</a></div>{% endif %}
</section>{% endblock %}
