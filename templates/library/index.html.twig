{% extends 'base.html.twig' %}
{% block title %}Ma bibliothèque · ZunaTrack{% endblock %}
{% block body %}
<section class="library" aria-labelledby="page-title"><header class="page-header"><p class="eyebrow">Collection personnelle</p><h1 id="page-title">Bibliothèque</h1><p class="lede">Vos séries, vos statuts et vos notes au même endroit.</p></header>
<form class="library-filters library-toolbar" method="get" data-controller="library-filter"><select id="status" name="status" aria-label="Filtrer par statut" data-action="change->library-filter#submit"><option value="">Tous les statuts</option>{% for value, label in statuses %}<option value="{{ value }}" {{ status == value ? 'selected' }}>{{ label }}</option>{% endfor %}</select><div class="library-search"><input id="q" name="q" type="search" value="{{ query }}" placeholder="Rechercher une série" aria-label="Rechercher une série" autocomplete="off" data-library-filter-target="query" data-action="input->library-filter#search"><svg class="library-search__icon" aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6"></circle><path d="m16 16 4 4"></path></svg><button class="library-search__clear" type="button" aria-label="Effacer la recherche" data-library-filter-target="clear" data-action="library-filter#clear" {% if not query %}hidden{% endif %}><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"></path></svg></button></div></form>
{% if entries %}<div class="library-grid">{% for entry in entries %}<article class="library-card">{% if entry.series.posterUrl %}<img src="{{ entry.series.posterUrl }}" alt="Affiche de {{ entry.series.title }}" loading="lazy">{% endif %}<div class="library-card__main"><p class="eyebrow">{{ statuses[entry.status] }}</p><h2><a href="{{ path('app_series_show', {id: entry.series.id}) }}">{{ entry.series.title }}</a></h2><p class="library-summary">{{ entry.series.summary ? entry.series.summary|striptags|slice(0, 360) ~ (entry.series.summary|length > 360 ? '…' : '') : 'Aucun résumé disponible.' }}</p><div class="library-pills">{% for genre in entry.series.genres %}<span>{{ genre }}</span>{% endfor %}{% if networks[entry.series.id]|default %}<span>{{ networks[entry.series.id] }}</span>{% endif %}</div></div><dl><div><dt>Saisons</dt><dd>{{ entry.series.seasons|length }}</dd></div>{% if entry.series.premieredAt %}<div><dt>Début</dt><dd>{{ entry.series.premieredAt|date('d/m/Y') }}</dd></div>{% endif %}{% if entry.series.endedAt %}<div><dt>Fin</dt><dd>{{ entry.series.endedAt|date('d/m/Y') }}</dd></div>{% endif %}<div><dt>Ajoutée</dt><dd>{{ entry.addedAt|date('d/m/Y') }}</dd></div></dl><div class="library-controls" aria-label="Actions à venir"><button type="button" disabled aria-label="Marquer comme vu" title="Marquer comme vu"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"></path></svg></button><button type="button" disabled aria-label="Regarder plus tard" title="Regarder plus tard"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"></circle><path d="M12 8v5l3 2"></path></svg></button><button type="button" disabled aria-label="Supprimer de la bibliothèque" title="Supprimer de la bibliothèque"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7h16M10 11v6m4-6v6M9 7l1-2h4l1 2M6 7l1 13h10l1-13"></path></svg></button></div></article>{% endfor %}</div>{% else %}<div class="library-empty"><h2>Votre bibliothèque attend sa première série.</h2><p class="lede">Explorez le catalogue, puis ajoutez les séries que vous souhaitez suivre.</p><a class="button button--primary" href="{{ path('app_catalog') }}">Explorer le catalogue</a></div>{% endif %}
</section>{% endblock %}
