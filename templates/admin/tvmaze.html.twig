{% extends 'base.html.twig' %}
{% block title %}Administration · Données TVmaze{% endblock %}
{% block body %}
<section class="admin"><p class="eyebrow">Administration</p><h1>Inspecteur TVmaze</h1>{% include 'admin/_tabs.html.twig' with {active: 'tvmaze'} %}
<p class="lede">Chaque inspection interroge TVmaze directement ; les limites d’appel restent actives.</p>
<form method="get" class="admin-inspector-form"><label>Recherche de série<input name="q" value="{{ query }}" placeholder="ex. Severance"></label><button class="button button--primary">Chercher</button></form>
{% if mode == 'search' %}<section><h2>Résultats bruts</h2><div class="raw-results">{% for result in payload %}<article><strong>{{ result.show.name|default('Sans titre') }}</strong><span>ID {{ result.show.id }}</span><a href="{{ path('app_admin_tvmaze',{show:result.show.id}) }}">Fiche complète</a><a href="{{ path('app_admin_tvmaze',{show:result.show.id,inspect:'cast'}) }}">Voir le casting brut</a></article>{% else %}<p>Aucun résultat.</p>{% endfor %}</div></section>
{% elseif mode in ['show', 'cast'] %}<section><h2>{{ mode == 'cast' ? 'Casting TVmaze' : payload.name|default('Réponse TVmaze') }}</h2>{% if mode == 'cast' %}<p class="lede">Réponse de <code>GET /shows/{{ showId }}?embed=cast</code>.</p>{% else %}<p class="lede">Métadonnées complètes, saisons, épisodes et médias quand TVmaze les fournit.</p>{% endif %}<p><a href="{{ path('app_admin_tvmaze',{show:showId,inspect:mode == 'cast' ? 'show' : 'cast'}) }}">{{ mode == 'cast' ? 'Voir la fiche complète' : 'Voir seulement le casting brut' }}</a></p><pre class="api-payload">{{ payload|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES')) }}</pre></section>{% endif %}
{% if error %}<div class="flash flash--error">{{ error }}</div>{% endif %}</section>
{% endblock %}
