{% extends 'base.html.twig' %}{% block title %}Administration · Données TVmaze{% endblock %}{% block body %}<section class="admin"><p class="eyebrow">Administration</p><h1>Inspecteur TVmaze</h1>{% include 'admin/_tabs.html.twig' with {active: 'tvmaze'} %}<p class="lede">Chaque recherche interroge TVmaze directement : ni cache applicatif, ni snapshot local. Les limites d’appel restent actives.</p><form method="get" class="admin-inspector-form"><label>Recherche de série<input name="q" value="{{ query }}" placeholder="ex. Severance"></label><button class="button button--primary">Chercher</button></form>{% if mode == 'search' %}<section><h2>Résultats bruts</h2><div class="raw-results">{% for result in payload %}<article><strong>{{ result.show.name|default('Sans titre') }}</strong><span>ID {{ result.show.id }}</span><a href="{{ path('app_admin_tvmaze',{show:result.show.id}) }}">Inspecter la réponse complète</a></article>{% else %}<p>Aucun résultat.</p>{% endfor %}</div></section>{% elseif mode == 'show' %}<section><h2>{{ payload.name|default('Réponse TVmaze') }}</h2><p class="lede">Inclus : saisons, épisodes, acteurs, équipe et images quand TVmaze les fournit.</p><pre class="api-payload">{{ payload|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES')) }}</pre></section>{% endif %}{% if error %}<div class="flash flash--error">{{ error }}</div>{% endif %}</section>{% endblock %}
