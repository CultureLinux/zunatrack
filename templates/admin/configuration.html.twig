{% extends 'base.html.twig' %}{% block title %}Administration · Configuration{% endblock %}{% block body %}<section class="admin admin-configuration"><p class="eyebrow">Administration</p><h1>Configuration</h1>{% include 'admin/_tabs.html.twig' with {active: 'configuration'} %}<div class="configuration-grid"><section class="configuration-card"><div><p class="eyebrow">Accès</p><h2>Inscriptions</h2><p>Contrôlez l’arrivée de nouveaux comptes sans toucher aux comptes existants.</p></div><form method="post" action="{{ path('app_admin_configuration_registration') }}"><input type="hidden" name="_token" value="{{ csrf_token('instance-registration') }}"><label class="configuration-switch"><input type="checkbox" name="public_registration" value="1" {{ configuration.publicRegistration ? 'checked' }}><span>Autoriser les nouveaux comptes</span></label><label class="form-field">Plafond de comptes <input name="account_limit" type="number" min="1" value="{{ configuration.accountLimit ?? '' }}" placeholder="Sans limite"><small>Laissez vide pour ne fixer aucune limite.</small></label><button class="button button--primary" type="submit">Enregistrer</button></form></section><section class="configuration-card configuration-card--vapid"><div><p class="eyebrow">Diffusion</p><h2>Notifications Web Push</h2><p>La clé privée est chiffrée et ne réapparaît jamais.</p></div><form method="post" action="{{ path('app_admin_configuration_vapid') }}"><input type="hidden" name="_token" value="{{ csrf_token('instance-vapid') }}"><label class="form-field">Sujet VAPID <input name="vapid_subject" required value="{{ configuration.vapidSubject ?? '' }}" placeholder="mailto:admin@example.test"></label><label class="form-field">Clé publique <textarea name="vapid_public_key" required rows="3">{{ configuration.vapidPublicKey ?? '' }}</textarea></label><label class="form-field">Clé privée <textarea name="vapid_private_key" required rows="3" placeholder="{{ configuration.encryptedVapidPrivateKey ? 'Saisir une nouvelle clé pour la remplacer' : '' }}"></textarea></label><button class="button button--primary" type="submit">Enregistrer les clés</button></form></section></div></section>{% endblock %}
