{% extends 'base.html.twig' %}{% block title %}Administration · Statistiques{% endblock %}{% block body %}<section class="admin" data-controller="admin-stats" data-admin-stats-url-value="{{ path('app_admin_stats_api') }}"><p class="eyebrow">Administration</p><h1>Statistiques</h1>{% include 'admin/_tabs.html.twig' with {active: 'stats'} %}<p data-admin-stats-target="status" role="status">Chargement…</p><div class="stat-grid" aria-busy="true"><a href="{{ path('app_admin_users') }}"><span>Utilisateurs</span><strong data-admin-stats-target="users">—</strong></a><a href="{{ path('app_admin_users') }}"><span>Administrateurs</span><strong data-admin-stats-target="admins">—</strong></a><a href="{{ path('app_admin_series') }}"><span>Séries</span><strong data-admin-stats-target="series">—</strong></a><a href="{{ path('app_admin_library') }}"><span>Fiches bibliothèque</span><strong data-admin-stats-target="entries">—</strong></a></div><section class="traffic-chart" aria-labelledby="traffic-title"><p class="eyebrow">Efficacité du cache</p><h2 id="traffic-title">Requêtes catalogue</h2><p class="lede">Comparaison des appels cumulés depuis la dernière purge du cache.</p><div class="traffic-bars" role="img" aria-label="Comparaison des requêtes locales et fournisseur"><div class="traffic-bar traffic-bar--local" data-admin-stats-target="local"><span>ZunaTrack local</span><i></i><strong>—</strong></div><div class="traffic-bar traffic-bar--provider" data-admin-stats-target="provider"><span>TVmaze fournisseur</span><i></i><strong>—</strong></div></div></section></section>{% endblock %}
