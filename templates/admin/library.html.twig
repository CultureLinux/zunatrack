{% extends 'base.html.twig' %}{% block title %}Administration · Bibliothèque{% endblock %}{% block body %}<section class="admin"><p class="eyebrow">Administration</p><h1>Bibliothèque globale</h1>{% include 'admin/_tabs.html.twig' with {active: 'library'} %}<div class="admin-table">{% for entry in entries %}<article><div><strong>{{ entry.series.title }}</strong><p>{{ entry.user.email }} · {{ constant('App\\Entity\\LibraryEntry::STATUSES')[entry.status] }}</p></div><span class="admin-date">Modifié {{ entry.updatedAt|date('d/m/Y') }}</span></article>{% else %}<p>Aucune fiche de bibliothèque.</p>{% endfor %}</div></section>{% endblock %}
