{% extends 'base.html.twig' %}{% block title %}Administration · Modifier un compte{% endblock %}{% block body %}<section class="admin"><header class="page-header"><p class="eyebrow">Administration</p><h1>Modifier un compte</h1><p class="lede">Gérez les droits et le mot de passe de {{ managedUser.email }}.</p></header>{% include 'admin/_tabs.html.twig' with {active: 'users'} %}<form method="post" class="admin-form form-card form-stack"><p>{{ managedUser.email }}</p><label class="form-check"><input type="checkbox" name="admin" value="1" {{ 'ROLE_ADMIN' in managedUser.roles ? 'checked' }}> Administrateur</label><label class="form-field">Nouveau mot de passe <small>Laisser vide pour ne pas le modifier · 12 caractères minimum.</small><input type="password" name="plain_password" autocomplete="new-password" minlength="12"></label><input type="hidden" name="_token" value="{{ csrf_token('admin_user_'~managedUser.id) }}"><div class="form-actions"><a class="button" href="{{ path('app_admin_users') }}">Annuler</a><button class="button button--primary" type="submit">Enregistrer</button></div></form></section>{% endblock %}
