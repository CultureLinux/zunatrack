{% extends 'base.html.twig' %}{% block title %}Administration · Utilisateurs{% endblock %}{% block body %}<section class="admin"><p class="eyebrow">Administration</p><h1>Comptes utilisateurs</h1><nav class="admin-tabs" aria-label="Administration"><a class="is-active" href="{{ path('app_admin_users') }}">Utilisateurs</a><a href="{{ path('app_admin_stats') }}">Statistiques</a></nav><div class="admin-table">{% for user in users %}<article><div><strong>{{ user.email }}</strong><p>{{ 'ROLE_ADMIN' in user.roles ? 'Administrateur' : 'Membre' }}</p></div><form method="post" action="{{ path('app_admin_user_role',{id:user.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_role_'~user.id) }}"><button class="button" {{ app.user.id == user.id ? 'disabled' }}>{{ 'ROLE_ADMIN' in user.roles ? 'Retirer admin' : 'Rendre admin' }}</button></form></article>{% endfor %}</div></section>{% endblock %}
