{% extends 'base.html.twig' %}{% block title %}Administration · Utilisateurs{% endblock %}{% block body %}<section class="admin"><p class="eyebrow">Administration</p><h1>Comptes utilisateurs</h1>{% include 'admin/_tabs.html.twig' with {active: 'users'} %}<div class="admin-table">{% for user in users %}<article><div><strong>{{ user.email }}</strong><p>{{ 'ROLE_ADMIN' in user.roles ? 'Administrateur' : 'Membre' }}</p></div><div class="admin-actions"><a class="button" href="{{ path('app_admin_user_edit',{id:user.id}) }}">Modifier</a>{% if app.user.id != user.id %}<form method="post" action="{{ path('app_admin_user_impersonate',{id:user.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_impersonate_'~user.id) }}"><button class="button" type="submit">Usurper</button></form>{% endif %}</div></article>{% else %}<p>Aucun compte.</p>{% endfor %}</div></section>{% endblock %}
