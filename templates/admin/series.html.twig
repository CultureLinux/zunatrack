{% extends 'base.html.twig' %}{% block title %}Administration · Séries{% endblock %}{% block body %}<section class="admin"><p class="eyebrow">Administration</p><h1>Séries importées</h1>{% include 'admin/_tabs.html.twig' with {active: 'series'} %}<div class="admin-table">{% for item in series %}<article><div><strong><a href="{{ path('app_series_show',{id:item.id}) }}">{{ item.title }}</a></strong><p>{{ item.seasons|length }} saison{{ item.seasons|length > 1 ? 's' }} · {{ item.status ?: 'Statut inconnu' }}</p></div><span class="admin-date">Mis à jour {{ item.updatedAt|date('d/m/Y') }}</span></article>{% else %}<p>Aucune série importée.</p>{% endfor %}</div></section>{% endblock %}
