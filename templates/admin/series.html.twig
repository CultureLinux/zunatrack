{% extends 'base.html.twig' %}{% block title %}Administration · Séries{% endblock %}{% block body %}<section class="admin"><p class="eyebrow">Administration</p><h1>Séries importées</h1>{% include 'admin/_tabs.html.twig' with {active: 'series'} %}<div data-controller="admin-series-repair" data-admin-series-repair-url-value="{{ path('app_admin_series_repair') }}" data-admin-series-repair-token-value="{{ csrf_token('admin_series_repair') }}"><button class="button" type="button" data-action="admin-series-repair#open">Vérifier et rafraîchir les séries</button><dialog class="import-dialog" data-admin-series-repair-target="dialog" data-action="click->admin-series-repair#backdrop close->admin-series-repair#stop"><form method="dialog"><button class="dialog-close" aria-label="Fermer" type="submit">×</button></form><h2>Vérification du catalogue</h2><p>Les séries sont traitées une par une. Gardez cette fenêtre ouverte pendant la vérification.</p><button class="button button--primary" type="button" data-admin-series-repair-target="start" data-action="admin-series-repair#start">Lancer la vérification</button><p role="status" data-admin-series-repair-target="status"></p><progress data-admin-series-repair-target="progress" value="0" max="1"></progress><ol class="import-live-list" data-admin-series-repair-target="items"></ol></dialog></div><div class="admin-table">{% for item in series %}<article><img class="admin-series__poster" src="{{ item.posterUrl ?: asset('images/zunatrack-mark.svg') }}" alt="{% if item.posterUrl %}Affiche de {{ item.title }}{% endif %}"><div><strong><a href="{{ path('app_series_show',{id:item.id}) }}">{{ item.title }}</a></strong><p>{{ item.seasons|length }} saison{{ item.seasons|length > 1 ? 's' }} · {{ item.status ?: 'Statut inconnu' }}</p></div><span class="admin-date">Mis à jour {{ item.updatedAt|date('d/m/Y') }}</span></article>{% else %}<p>Aucune série importée.</p>{% endfor %}</div>{% if pages > 1 %}<nav class="admin-pagination">{% if page > 1 %}<a href="{{ path('app_admin_series',{page:page-1}) }}">← Précédente</a>{% endif %}<span>Page {{ page }} sur {{ pages }} · {{ total }} séries</span>{% if page < pages %}<a href="{{ path('app_admin_series',{page:page+1}) }}">Suivante →</a>{% endif %}</nav>{% endif %}</section>{% endblock %}
